# Optional: copy to .env to change these defaults. Everything runs locally; no API keys needed.

# --- Ollama (local LLM for the Kavach Assistant) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- Voice ---
# faster-whisper size: "small" (default) or "base" (faster, much worse on Hinglish speech)
WHISPER_MODEL=small
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
