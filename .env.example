# Copy to .env and fill in. NEVER commit .env.

# ollama (local) | openrouter (hosted)
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- OpenRouter (hosted / HF Spaces) ---
OPENROUTER_API_KEY=
# Pick a current free model that supports tool calling
OPENROUTER_MODEL=

# --- Voice ---
# faster-whisper size: "small" (default) or "base" (faster, much worse on Hinglish speech)
WHISPER_MODEL=small
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
